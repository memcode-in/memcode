# Account and memory API.
VITE_MEMORY_API_URL=https://memory.memcode.in
# Company Brain runtime and billing API. Required in production unless the web
# origin reverse-proxies /api to Brain. It never falls back to the memory API.
# Keep it on the same HTTPS parent site (for example, app.memcode.com and
# brain.memcode.com) for its HttpOnly session.
VITE_MEMCODE_BRAIN_API_URL=https://your-company-brain-api.example.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Public Razorpay checkout key. The API may also return key_id with an order.
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key
# Marketing site used by the dashboard's back-to-home link.
VITE_MEMCODE_LANDING_URL=https://memcode.in
