{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memcode-dashboard",
  "compatibility_date": "2026-08-12",
  "routes": [
    {
      "pattern": "app.memcode.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
